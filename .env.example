# Auf dem Server nach .env kopieren und PUTZAPP_SECRET ersetzen:
#   cp .env.example .env
#   openssl rand -hex 32   -> Wert in .env eintragen
#
# Ohne PUTZAPP_SECRET generiert die App selbst ein Secret und legt es in der
# DB ab (kv-Tabelle) – das überlebt Neustarts. Explizit setzen ist trotzdem
# sauberer: gleiches Secret auf allen Instanzen, kein Geheimnis in der DB.
PUTZAPP_SECRET=bitte-aendern

# Optional: Stimmen-Schwelle für automatisch übernommene Ideen (Standard: 5)
# PUTZAPP_APPROVE_VOTES=5

# ---------------------------------------------------------------------------
# Push-Benachrichtigungen (Riffpost ans Handy) – optional, aber empfohlen.
# Ohne diese Schlüssel läuft die App normal, nur ohne Push-Benachrichtigungen.
#
# Schlüssel EINMALIG erzeugen und dann dauerhaft hier eintragen:
#   npx web-push generate-vapid-keys --json
# (läuft im Projekt-Ordner; erzeugt { publicKey, privateKey } im JSON-Format)
#
# VAPID_SUBJECT ist eine Kontaktadresse für den Push-Service (mailto: oder
# https:-URL) – für den Eigenbetrieb reicht die eigene E-Mail.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@email.de
